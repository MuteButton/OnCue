<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque square art covers the complete 72dp launcher viewport.
     Only the launcher applies the adaptive icon's outer shape. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.666667%" android:insetRight="16.666667%"
    android:insetTop="16.666667%" android:insetBottom="16.666667%">
    <bitmap android:src="@drawable/oncue_launcher_art" android:gravity="fill" android:filter="true" />
</inset>
